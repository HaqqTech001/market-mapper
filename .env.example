# Market Mapper V1 Environment Configuration Example
# Copy this file to .env or configure in your deployment platform
# DO NOT COMMIT REAL SECRETS OR API KEYS

# Google Maps API Key (Android Native)
# Used by react-native-maps in android/app/src/main/AndroidManifest.xml
GOOGLE_MAPS_API_KEY=

# Supabase Public Configuration (Phase 2 Integration)
# Client-safe configuration: ANON key only. NEVER expose the service-role key!
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Application Environment
EXPO_PUBLIC_ENV=development
