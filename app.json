{
  "expo": {
    "name": "Market Mapper",
    "slug": "market-mapper",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "marketmapper",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marketmapper.app"
    },
    "android": {
      "package": "com.marketmapper.app"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
