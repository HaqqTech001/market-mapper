{
  "expo": {
    "name": "Market Mapper",
    "slug": "market-mapper",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "marketmapper",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haqqtech.marketmapper",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Market Mapper uses your location to capture businesses, places and market paths."
      }
    },
    "android": {
      "package": "com.haqqtech.marketmapper",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7FAF8"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Market Mapper to use your location while mapping markets."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Market Mapper to select a field photo for a mapped business.",
          "cameraPermission": "Allow Market Mapper to take field photos for mapped businesses."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7FAF8"
    }
  }
}
